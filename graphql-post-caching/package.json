{
  "name": "graphql-post-caching",
  "version": "1.0.0",
  "private": true,
  "description": "Book GraphQL API for comparing a direct origin with the same origin behind GraphPilot, plus an educational in-memory GraphQL POST cache.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "origin": "node origin/server.js",
    "start": "node origin/server.js",
    "compare": "bash graphpilot/compare.sh",
    "educational": "node educational-cache/server.js",
    "educational:demo": "bash educational-cache/examples/curl-walkthrough.sh",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "graphql": "^16.15.0",
    "graphql-yoga": "^6.0.1"
  }
}
